<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  
  <action id="com.greywatch.apply.unban-ip">
    <description>greywatch unban-ip helper</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/unban-ip.sh</annotate>
  </action>
  <action id="com.greywatch.apply.drop-listener">
    <description>greywatch drop-listener helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/drop-listener.sh</annotate>
  </action>
  <action id="com.greywatch.apply.restore-quarantine">
    <description>greywatch restore-quarantine helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/restore-quarantine.sh</annotate>
  </action>
  <action id="com.greywatch.apply.keep-quarantine">
    <description>greywatch keep-quarantine helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/keep-quarantine.sh</annotate>
  </action>
  <action id="com.greywatch.apply.keep-scan-ban">
    <description>greywatch keep-scan-ban helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/keep-scan-ban.sh</annotate>
  </action>
  <action id="com.greywatch.apply.widen-scan-ban">
    <description>greywatch widen-scan-ban helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/widen-scan-ban.sh</annotate>
  </action>
  <action id="com.greywatch.apply.scan-now">
    <description>greywatch manual-scan helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/scan-now.sh</annotate>
  </action>
  <action id="com.greywatch.apply.harden">
    <description>greywatch harden helper</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/harden.sh</annotate>
  </action>
  <action id="com.greywatch.apply.file-action">
    <description>greywatch quarantine or delete a file named by a scan finding</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/file-action.sh</annotate>
  </action>
  <action id="com.greywatch.apply.tool-control">
    <description>greywatch tool on/off helper (start-all, stop-all, scan-all)</description>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/tool-control.sh</annotate>
  </action>
  <action id="com.greywatch.apply.batch">
    <description>greywatch apply a batch of decision answers with one prompt</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/batch.sh</annotate>
  </action>
  <action id="com.greywatch.apply.psad-tune">
    <description>greywatch feed psad from the live firewall and arm its conservative auto-block (danger level 5 only, own LAN whitelisted)</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/psad-tune.sh</annotate>
  </action>
  <action id="com.greywatch.apply.hardening-arp">
    <description>greywatch pin the real router in the ARP table and set ARP-spoof resistant kernel settings</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/hardening-arp.sh</annotate>
  </action>
  <action id="com.greywatch.apply.block-ip">
    <description>greywatch hold one address out of the firewall for good (keeper decision, recorded in the blocked-IP ledger)</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/block-ip.sh</annotate>
  </action>
  <action id="com.greywatch.apply.lift-block">
    <description>greywatch release one blocked address (keeper decision; the only path that un-blocks)</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/lift-block.sh</annotate>
  </action>
  <action id="com.greywatch.apply.block-review">
    <description>greywatch record the keeper's verdict on a block reviewer question (ledger note only, never acts on the firewall)</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/block-review.sh</annotate>
  </action>
  <action id="com.greywatch.apply.baseline-update">
    <description>greywatch refresh a checker baseline the keeper has reviewed (rkhunter propupd, or AIDE through its daily config; the previous baseline is kept)</description>
    <vendor>greywatch</vendor>
    <defaults><allow_any>auth_admin</allow_any><allow_active>auth_admin_keep</allow_active><allow_inactive>no</allow_inactive></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">__GW_LIB__/apply/baseline-update.sh</annotate>
  </action>
</policyconfig>
