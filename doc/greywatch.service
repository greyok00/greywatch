[Unit]
Description=greywatch — one root-privileged security monitor daemon
Documentation=file:__GW_HOME__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/usr/bin/python3 __GW_HOME__/greywatch_daemon.py
ExecStopPost=/bin/sh -c "/usr/sbin/nft delete table inet greywatch_appfw; exit 0"
Restart=always
RestartSec=5
RuntimeDirectory=greywatch
RuntimeDirectoryMode=0755
PrivateTmp=true
CPUQuota=50%
MemoryMax=768M
Nice=5
IOSchedulingClass=best-effort
NoNewPrivileges=true
UMask=0077
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target