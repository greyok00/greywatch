{
  "controls": [
    {
      "id": "gw-unit-hardening",
      "group": "systemd-unit",
      "what": "Service unit runs hardened (NoNewPrivileges=true, sandboxing directives in place). If the unit is already hardened, nothing to do.",
      "baseline": "unit file contains NoNewPrivileges=true",
      "probe": "grep -q '^NoNewPrivileges=true' /etc/systemd/system/{{unit}}.service",
      "probe_invert": false,
      "fix": [["unit-install", "{{unit}}", "TRANCHE"]],
      "nist": ["CM-7", "SC-2"],
      "cis": ["1.6"],
      "severity": "CRITICAL",
      "family": "CM",
      "nist_family": "Configuration Management",
      "cis_ref": "1.6",
      "break_risk": "low",
      "default": true,
      "persist": true,
      "condition": "always"
    },
    {
      "id": "sysctl-userns",
      "group": "kernel",
      "what": "Unprivileged user namespace cloning is disabled (container-escape surface).",
      "baseline": "0",
      "probe": "sysctl -n kernel.unprivileged_userns_clone",
      "probe_invert": false,
      "fix": [["sysctl-set", "kernel.unprivileged_userns_clone", "0"]],
      "nist": ["AC-4", "CM-6"],
      "cis": [],
      "severity": "HIGH",
      "family": "CM",
      "nist_family": "Configuration Management",
      "cis_ref": "",
      "break_risk": "medium",
      "default": true,
      "persist": true,
      "condition": "always"
    },
    {
      "id": "sysctl-bpf",
      "group": "kernel",
      "what": "Unprivileged BPF is disabled (kernel ≥1 means locked; 2 disallows even privileged helpers).",
      "baseline": ">=1",
      "probe": "sysctl -n kernel.unprivileged_bpf_disabled",
      "probe_invert": false,
      "fix": [["sysctl-set", "kernel.unprivileged_bpf_disabled", "2"]],
      "nist": ["CM-7"],
      "cis": [],
      "severity": "HIGH",
      "family": "SC",
      "nist_family": "System and Communications Protection",
      "cis_ref": "",
      "break_risk": "low",
      "default": true,
      "persist": true,
      "condition": "always"
    },
    {
      "id": "sshd-running",
      "group": "network-services",
      "what": "SSH service is not active on a workstation-class endpoint.",
      "baseline": "inactive",
      "probe": "systemctl is-active ssh",
      "probe_invert": true,
      "fix": [["service-off", "ssh"]],
      "nist": ["CM-7"],
      "cis": [],
      "severity": "MEDIUM",
      "family": "AC",
      "nist_family": "Access Control",
      "cis_ref": "",
      "break_risk": "medium",
      "default": true,
      "persist": true,
      "condition": "always"
    },
    {
      "id": "avahi-running",
      "group": "network-services",
      "what": "mDNS discovery (avahi-daemon) is not active; it leaks host presence on the LAN.",
      "baseline": "inactive",
      "probe": "systemctl is-active avahi-daemon",
      "probe_invert": true,
      "fix": [["service-off", "avahi-daemon"]],
      "nist": ["CM-7"],
      "cis": [],
      "severity": "MEDIUM",
      "family": "CM",
      "nist_family": "Configuration Management",
      "cis_ref": "",
      "break_risk": "low",
      "default": true,
      "persist": true,
      "condition": "always"
    },
    {
      "id": "updates-backlog",
      "group": "updates",
      "what": "Pending package upgrades are FLAGGED here, never forced: upgrading can restart services mid-task or change behavior out from under you, so the manual choice is `apt list --upgradable`, review, then `apt upgrade` at a moment you pick. Advisory card; no automatic package change ever.",
      "baseline": "flag only: 0 or more upgradable",
      "probe": "test $(apt list --upgradable 2>/dev/null | wc -l) -eq 1",
      "probe_invert": false,
      "fix": [],
      "nist": ["SI-2", "RA-5"],
      "cis": [],
      "severity": "HIGH",
      "advisory": true,
      "family": "SI",
      "nist_family": "System and Information Integrity",
      "cis_ref": "",
      "break_risk": "none",
      "default": "FLAG-ONLY",
      "persist": false,
      "condition": "always"
    },
    {
      "id": "ufw-frontend-role",
      "group": "firewall-frontend",
      "what": "UFW is inactive — greywatch's own nftables tables are the working host firewall; the frontend role is this app's by design. Read-only truth check (PASS when the app's nftables rules exist or UFW is armed), advisory, never applied.",
      "baseline": "app nftables tables present (or UFW active)",
      "probe": "nft list tables 2>/dev/null | grep -q 'greywatch' || ufw status 2>/dev/null | grep -qi 'status: active'",
      "probe_invert": false,
      "fix": [["sh", "true"]],
      "nist": ["SC-7"],
      "cis": [],
      "severity": "INFO",
      "advisory": true,
      "family": "SC",
      "nist_family": "System and Communications Protection",
      "cis_ref": "",
      "break_risk": "none",
      "default": "FLAG-ONLY",
      "persist": false,
      "condition": "always"
    },
    {
      "id": "mac-in-repo",
      "group": "privacy",
      "what": "Tracked files match the real MAC-address pattern (link-layer identifiers must not ship in repo or exports). Advisory: the card surfaces the finding for manual redaction; it never auto-edits files.",
      "baseline": "0 matches",
      "probe": "grep -rIlE '([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}' --exclude-dir=.git .",
      "probe_invert": true,
      "fix": [["sh", "true"]],
      "nist": ["AC-4"],
      "cis": [],
      "severity": "MEDIUM",
      "advisory": true,
      "family": "AC",
      "nist_family": "Access Control",
      "cis_ref": "",
      "break_risk": "none",
      "default": "FLAG-ONLY",
      "persist": false,
      "condition": "always"
    },
    {
      "id": "arp-policy-doc",
      "group": "privacy",
      "what": "Standing privacy ruling recorded: runtime observation of MAC addresses is allowed; repository contents and exported reports are always masked. Always-pass advisory card; no action required.",
      "baseline": "always pass",
      "probe": "true",
      "probe_invert": false,
      "fix": [["sh", "true"]],
      "nist": ["AC-4"],
      "cis": [],
      "severity": "INFO",
      "advisory": true,
      "family": "AC",
      "nist_family": "Access Control",
      "cis_ref": "",
      "break_risk": "none",
      "default": "FLAG-ONLY",
      "persist": false,
      "condition": "always"
    },
    {
      "id": "ipv6-block-all",
      "group": "firewall",
      "what": "IPv6 is blocked kernel-wide (block-all posture): an unrouted IPv6 stack is one less lane an adversary can reach. On a FRESH INSTALL this ships on by default; on an existing machine the flip is by owner hand, with the plain-English warning, verify and rollback the app already provides.",
      "baseline": "1 (IPv6 disabled kernel-wide)",
      "probe": "test $(sysctl -n net.ipv6.conf.all.disable_ipv6) -eq 1",
      "probe_invert": false,
      "fix": [["sysctl-set", "net.ipv6.conf.all.disable_ipv6", "1"]],
      "nist": ["SC-7(5)", "SC-7"],
      "cis": [],
      "severity": "HIGH",
      "family": "SC",
      "nist_family": "System and Communications Protection",
      "cis_ref": "",
      "break_risk": "medium",
      "default": true,
      "persist": true,
      "condition": "fresh-install"
    },
    {
      "id": "clamav-installed",
      "group": "malware-scanning",
      "what": "Checks that the antivirus engine (ClamAV) is on this computer (SI-3). If it is missing, the Setup Wizard offers a one-click install prompt — never installed silently, never scheduled by itself; the choice stays with the owner. Advisory card until the wizard's install prompt runs.",
      "baseline": "installed",
      "probe": "dpkg-query -W -f='${Status}' clamav 2>/dev/null | grep -q 'install ok installed'",
      "probe_invert": false,
      "fix": [],
      "nist": ["SI-3"],
      "cis": [],
      "severity": "MEDIUM",
      "advisory": true,
      "family": "SI",
      "nist_family": "System and Information Integrity",
      "cis_ref": "",
      "break_risk": "none",
      "default": false,
      "persist": false,
      "condition": "not-installed:clamav",
      "action": "install-prompt"
    }
  ]
}
