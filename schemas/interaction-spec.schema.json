{
 "title": "interaction spec (decisions.jsonl one-pipeline records)",
 "type": "object",
 "required": ["id", "question", "options"],
 "properties": {
  "id":       {"type": "string", "minLength": 1, "maxLength": 200},
  "question": {"type": "string", "maxLength": 2000},
  "host":     {"type": "string", "maxLength": 200},
  "options": {
   "type": "array",
   "minItems": 1,
   "maxItems": 8,
   "items": {
    "type": "object",
    "required": ["id", "label", "helper", "args"],
    "properties": {
     "id":     {"type": "string", "minLength": 1, "maxLength": 64},
     "label":  {"type": "string", "minLength": 1, "maxLength": 120},
     "helper": {"type": "string",
                "enum": ["none", "ufw-apply", "ufw-rollback", "f2b-write",
                         "unban-ip", "tool-control", "keep-quarantine",
                         "restore-quarantine", "drop-listener", "scan-now",
                         "yara-write", "tetra-write", "arpwrite"]},
     "args":   {"type": "array", "maxItems": 8,
                "items": {"type": "string", "maxLength": 200}}
    }
   }
  }
 }
}